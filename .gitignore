```gitignore
# Environment variables
.env

# VS Code settings
.vscode/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# OS files
.DS_Store

# Virtual environments
venv/
venv39/

# Streamlit
.streamlit/

# Build / deployment
dist/
build/
*.egg-info/

# Logs
*.log

# ML / AI model files
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.npy

# Large datasets (optional but recommended)
*.csv
*.json
*.wav
*.mp3

# Torch / cache folders
torch/
.cache/
```
